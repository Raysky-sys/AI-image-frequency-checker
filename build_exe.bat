@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

set "APP_NAME=AI Image Frequency Checker"
set "EXE_NAME=AIImageFrequencyChecker"
set "MAIN_SCRIPT=AI_image_frequency_checker.py"
set "VERFILE=version_info.txt"
set "CHECKFILE=selfcheck_output.txt"

echo.
echo ==================================================
echo   %APP_NAME% - EXE Builder
echo ==================================================
echo.

REM ==============================================================
REM STEP 1 - Locate Python
REM ==============================================================
echo [Step 1/7] Locating Python...

set "PYEXE="

where py >nul 2>&1
if not errorlevel 1 (
    py -3 -c "import sys" >nul 2>&1
    if not errorlevel 1 set "PYEXE=py -3"
)

if not defined PYEXE (
    where python >nul 2>&1
    if not errorlevel 1 (
        python -c "import sys" >nul 2>&1
        if not errorlevel 1 set "PYEXE=python"
    )
)

if not defined PYEXE goto :no_python

echo           Command:  %PYEXE%
%PYEXE% -c "import sys; print('           Path:    ' + sys.executable); print('           Version: ' + sys.version.split()[0])"
echo.

REM ==============================================================
REM STEP 2 - Check and install runtime dependencies
REM ==============================================================
echo [Step 2/7] Checking runtime dependencies...

%PYEXE% -c "import numpy, cv2, matplotlib, tkinter" >nul 2>&1
if errorlevel 1 (
    echo           Missing dependencies, installing them now...
    %PYEXE% -m pip install --upgrade -r requirements.txt
    if errorlevel 1 goto :dep_failed
    %PYEXE% -c "import numpy, cv2, matplotlib, tkinter" >nul 2>&1
    if errorlevel 1 goto :dep_failed
) else (
    echo           All runtime dependencies are present.
)
echo.

REM ==============================================================
REM STEP 3 - Install PyInstaller
REM ==============================================================
echo [Step 3/7] Installing or updating PyInstaller...
%PYEXE% -m pip install --upgrade -r requirements-build.txt
if errorlevel 1 goto :pip_failed
echo.

REM ==============================================================
REM STEP 4 - Verify the project files
REM ==============================================================
echo [Step 4/7] Verifying project files...
echo.

if not exist "%MAIN_SCRIPT%" goto :no_main
if not exist "residual_core.py" goto :no_core
if not exist "forensic_tools.py" goto :no_forensics
if not exist "help_content.py" goto :no_help
if not exist "selfcheck.py" goto :no_selfcheck
if not exist "make_version_info.py" goto :no_maker

echo           All required source files found.
echo.

REM ==============================================================
REM STEP 4b - Run the pre-build self-check
REM
REM The output is written to a file as well as the screen, so a
REM failure can be inspected after the fact. The exit code is
REM captured BEFORE the file is displayed, because displaying a
REM file resets the error level.
REM ==============================================================
echo [Step 4b] Running pre-build self-checks...
echo.

%PYEXE% "selfcheck.py" > "%CHECKFILE%" 2>&1
set "CHECKRC=%ERRORLEVEL%"

type "%CHECKFILE%"
echo.

if not "%CHECKRC%"=="0" goto :selfcheck_failed

echo           Self-checks passed.
echo.

REM ==============================================================
REM STEP 5 - Generate the version resource
REM
REM Generated by Python, NOT by batch. Echoing this text from a
REM batch file fails, because cmd.exe treats the parentheses as
REM block syntax and the file never gets written.
REM ==============================================================
echo [Step 5/7] Generating version metadata...

%PYEXE% "make_version_info.py"
if errorlevel 1 goto :ver_failed
if not exist "%VERFILE%" goto :ver_missing

echo.

REM ==============================================================
REM STEP 6 - Locate and validate the icon
REM ==============================================================
echo [Step 6/7] Checking the application icon...

set "ICONOPT="

if exist "icon.ico" (
    echo           Found: icon.ico
    %PYEXE% -c "import sys;d=open('icon.ico','rb').read(4);sys.exit(0 if d==b'\x00\x00\x01\x00' else 1)"
    if errorlevel 1 goto :icon_bad
    for %%A in ("icon.ico") do echo           Size: %%~zA bytes
    set "ICONOPT=--icon "icon.ico" --add-data "icon.ico;.""
    echo           The custom icon will be embedded.
) else (
    echo           No icon.ico found in this folder.
    echo           The build will use the default PyInstaller icon.
)
echo.

REM ==============================================================
REM STEP 7 - Build
REM ==============================================================
echo [Step 7/7] Building the executable...
echo.

set "BUILDOPTS=--noconfirm --clean --onefile --windowed"
set "BUILDOPTS=%BUILDOPTS% --name "%EXE_NAME%""
set "BUILDOPTS=%BUILDOPTS% --version-file "%VERFILE%""
set "BUILDOPTS=%BUILDOPTS% !ICONOPT!"
set "BUILDOPTS=%BUILDOPTS% --hidden-import matplotlib.backends.backend_tkagg"
set "BUILDOPTS=%BUILDOPTS% --hidden-import help_content"
set "BUILDOPTS=%BUILDOPTS% --hidden-import forensic_tools"
set "BUILDOPTS=%BUILDOPTS% --collect-submodules residual_core"
set "BUILDOPTS=%BUILDOPTS% --collect-submodules forensic_tools"
set "BUILDOPTS=%BUILDOPTS% --collect-submodules analysis_cache"
set "BUILDOPTS=%BUILDOPTS% --hidden-import analysis_cache"
set "BUILDOPTS=%BUILDOPTS% --collect-submodules image_ops"
set "BUILDOPTS=%BUILDOPTS% --hidden-import image_ops"
set "BUILDOPTS=%BUILDOPTS% --exclude-module PyQt5"
set "BUILDOPTS=%BUILDOPTS% --exclude-module PyQt6"
set "BUILDOPTS=%BUILDOPTS% --exclude-module PySide"
set "BUILDOPTS=%BUILDOPTS% --exclude-module PySide6"
set "BUILDOPTS=%BUILDOPTS% --exclude-module pytest"
set "BUILDOPTS=%BUILDOPTS% --exclude-module IPython"
set "BUILDOPTS=%BUILDOPTS% --exclude-module notebook"
set "BUILDOPTS=%BUILDOPTS% --exclude-module tkinter.test"

if exist "%EXE_NAME%.spec" del /q "%EXE_NAME%.spec"

%PYEXE% -m PyInstaller %BUILDOPTS% "%MAIN_SCRIPT%"

if errorlevel 1 goto :build_failed
if not exist "dist\%EXE_NAME%.exe" goto :no_output

echo.
echo ==================================================
echo   BUILD COMPLETE
echo ==================================================
echo.
echo   Executable:
echo       %CD%\dist\%EXE_NAME%.exe
echo.
for %%A in ("dist\%EXE_NAME%.exe") do echo   Size: %%~zA bytes
echo.
if defined ICONOPT echo   Icon:    custom icon.ico embedded
if not defined ICONOPT echo   Icon:    default, no icon.ico was present
echo.
echo   Only the .exe is needed to run the program.
echo   The target PC does not need Python installed.
echo.
echo   Launch it with:
echo       dist\%EXE_NAME%.exe
echo.
pause
exit /b 0


REM ==============================================================
REM ERROR HANDLERS
REM
REM Every label is collected here, after the main flow ends with
REM an explicit exit. Nothing can fall into a handler by accident.
REM ==============================================================

:no_python
echo.
echo   [ERROR] Python was not found on this machine.
echo.
echo   Install Python 3.10 or newer from:
echo       https://www.python.org/downloads/
echo.
echo   IMPORTANT: tick "Add python.exe to PATH" and
echo   "tcl/tk and IDLE" during installation.
echo.
pause
exit /b 1

:dep_failed
echo.
echo   [ERROR] The runtime dependencies are not installed for this
echo           interpreter, and the automatic install failed.
echo.
echo   Run this by hand:
echo       %PYEXE% -m pip install --upgrade -r requirements.txt
echo.
pause
exit /b 1

:pip_failed
echo.
echo   [ERROR] Could not install PyInstaller.
echo.
echo   Run this by hand:
echo       %PYEXE% -m pip install --upgrade -r requirements-build.txt
echo.
pause
exit /b 1

:no_main
echo.
echo   [ERROR] %MAIN_SCRIPT% was not found in this folder.
echo.
pause
exit /b 1

:no_core
echo.
echo   [ERROR] residual_core.py was not found in this folder.
echo.
pause
exit /b 1

:no_forensics
echo.
echo   [ERROR] forensic_tools.py was not found in this folder.
echo.
pause
exit /b 1

:no_help
echo.
echo   [ERROR] help_content.py was not found in this folder.
echo.
pause
exit /b 1

:no_selfcheck
echo.
echo   [ERROR] selfcheck.py was not found in this folder.
echo           It runs the pre-build validation of the project.
echo.
pause
exit /b 1

:no_maker
echo.
echo   [ERROR] make_version_info.py was not found in this folder.
echo           This script generates the Windows version resource.
echo.
pause
exit /b 1

:selfcheck_failed
echo.
echo   [ERROR] The pre-build self-check failed.
echo.
echo   The full report was written to:
echo       %CD%\%CHECKFILE%
echo.
echo   Run the self-check directly to see it live:
echo       %PYEXE% selfcheck.py
echo.
echo   The project is not ready to build. Fix the problem reported
echo   above and run the build again.
echo.
pause
exit /b 1

:ver_failed
echo.
echo   [ERROR] The version resource could not be generated.
echo.
pause
exit /b 1

:ver_missing
echo.
echo   [ERROR] %VERFILE% was not created.
echo           Expected it in:
echo       %CD%
echo.
pause
exit /b 1

:icon_bad
echo.
echo   [ERROR] icon.ico is not a valid Windows icon file.
echo   The first four bytes must be 00 00 01 00.
echo.
echo   Fix the file, or delete it to build without a custom icon.
echo.
pause
exit /b 1

:build_failed
echo.
echo   [ERROR] The PyInstaller build failed. See the log above.
echo.
pause
exit /b 1

:no_output
echo.
echo   [ERROR] The build reported success but the executable
echo           was not produced in the dist folder.
echo.
pause
exit /b 1
